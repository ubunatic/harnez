# Containerfile.lmcoder — lmcoder serving a small model on CPU for the agent
# smoke test (issue 723). Model weights are downloaded on first run into the
# /cache volume, never baked into the image.
#
# Build context is the repository root; run via make smoke-container.
FROM golang:1.26-bookworm AS lmcoder-build

ENV GOTOOLCHAIN=auto
# Busts the clone cache when lmcoder's main branch moves.
ADD https://codeberg.org/api/v1/repos/ubunatic/lmcoder/branches/main /tmp/lmcoder-main.json
RUN git clone --depth 1 https://codeberg.org/ubunatic/lmcoder.git /src
WORKDIR /src
RUN go build -trimpath -buildvcs=false -o /out/lmcoder ./cmd/lmcoder

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Official CPU build of llama.cpp, same release lmcoder pins for its models.
ARG LLAMA_CPP_VERSION=b10590
RUN mkdir -p /opt/llama.cpp \
    && curl -fsSL "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_CPP_VERSION}/llama-${LLAMA_CPP_VERSION}-bin-ubuntu-x64.tar.gz" \
       | tar -xz -C /opt/llama.cpp --strip-components=1 \
    && /opt/llama.cpp/llama-server --version

COPY --from=lmcoder-build /out/lmcoder /usr/local/bin/lmcoder
COPY scripts/agent-canary/bin/lmcoder-serve /usr/local/bin/lmcoder-serve
RUN chmod 755 /usr/local/bin/lmcoder /usr/local/bin/lmcoder-serve

ENV LMCODER_MODEL=canary \
    LMCODER_CTX_SIZE=32768

VOLUME /cache
EXPOSE 8734

ENTRYPOINT ["/usr/local/bin/lmcoder-serve"]
