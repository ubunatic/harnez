[Unit]
Description=harnez agent usage-collector daemon (issue 082)
Documentation=https://codeberg.org/ubunatic/harnez
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{HARNEZ_BIN}} server
Restart=on-failure
RestartSec=5s

# Writes usage data under %S/harnez and listens on 127.0.0.1.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/harnez %D/harnez %C/harnez

[Install]
WantedBy=default.target
