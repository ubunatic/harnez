[Unit]
Description=harnez agent usage-collector daemon (issue 082)
Documentation=https://codeberg.org/ubunatic/harnez
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{HARNEZ_BIN}} server
Restart={{RESTART_POLICY}}
RestartSec={{RESTART_DELAY}}
RuntimeDirectory=harnez
RuntimeDirectoryPreserve=yes
{{SSH_AUTH_SOCK_ENV}}
Environment="PATH=%h/.local/bin:%h/go/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"

# Writes its Unix socket and usage data to the per-user XDG directories.
# SQLite needs a writable temporary directory under this strict filesystem sandbox.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%t/harnez -%S/harnez -%C/harnez -%h/.local/share/harnez

[Install]
WantedBy=default.target
