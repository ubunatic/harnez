[Unit]
Description=Harnez Modifier Daemon (evdev physical modifier monitor)
Documentation=https://github.com/ubunatic/harnez
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/harnez-modifierd --state-file /run/harnez/modifiers --interval 10ms
Restart=always
RestartSec=2

# Security & Isolation sandbox settings
# Needs read access to /dev/input and write access to /run/harnez
RuntimeDirectory=harnez
RuntimeDirectoryMode=0755
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/harnez
DeviceAllow=char-input r
SupplementaryGroups=input

# Privacy protection: zero non-modifier keylogging
CapabilityBoundingSet=
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
