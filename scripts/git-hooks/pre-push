#!/bin/sh
# Git LFS part, unchanged, followed by the GitHub guard. The remote "both" pushes to
# Codeberg first and GitHub second, and this hook runs once per URL. Skip it with --no-verify.
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }

refs=$(cat)
printf '%s\n' "$refs" | git lfs pre-push "$@" || exit $?

# Ticket numbers: a ticket added here must not reuse a number that origin/main gives to another
# file (issue 1099). A failed fetch only warns; a confirmed collision blocks the push.
if test -d issues && command -v harnez >/dev/null 2>&1
then
    git fetch --quiet origin main 2>/dev/null || echo >&2 "pre-push: could not fetch origin main; ticket numbers checked against the last fetched copy"
    harnez issues lint --against origin/main || exit $?
fi

case "$1:$2" in
both:*github.com*)
    ;;
*)
    exit 0
    ;;
esac

status=0
while read -r local_ref local_sha remote_ref remote_sha
do
    test -n "$remote_ref" || continue
    case "$remote_ref" in
    refs/tags/*)
        ;;
    refs/heads/main)
        codeberg_sha=$(git ls-remote origin refs/heads/main | cut -f1)
        if test "$local_sha" != "$codeberg_sha"
        then
            echo >&2 "pre-push: GitHub refused: Codeberg main is at ${codeberg_sha:-unknown}, not $local_sha"
            status=1
        fi
        ;;
    *)
        echo >&2 "pre-push: GitHub takes only main and tags; not pushing $remote_ref there"
        status=1
        ;;
    esac
done <<EOF
$refs
EOF
exit $status
