#!/bin/sh
# Run Codex against the pod-local model server. The provider is passed as -c
# overrides so ~/.codex/config.toml keeps exactly what harnez apply wrote.
set -eu

base_url="${HARNEZ_AGENT_CANARY_BASE_URL:-http://127.0.0.1:8734/v1}"

exec codex \
  -c model_provider=lmcoder \
  -c "model_providers.lmcoder={name=\"lmcoder\",base_url=\"${base_url}\",wire_api=\"responses\"}" \
  -c model=local-model \
  "$@"
