REEL main
  mode = tui
  title = "smoke: agy sees installed skills"
  pause = 1s
  app_width = 800
  app_height = 600

  $ agy desc="start antigravity"
  P 5s desc="await login"
  $ /skills
  P 3s desc="await skills list"
  V contains="evergreen"
  V contains="domain-modeling"
  T <esc>
  P 1s
  $ /exit desc="exit antigravity"
