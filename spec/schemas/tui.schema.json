{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubunatic.com/harnez/spec/schemas/tui.schema.json",
  "title": "harnez tui interactive harness layout and keybindings spec",
  "type": "object",
  "required": ["header", "chat", "input", "sessions", "terminal", "editor", "native", "jobs", "picker", "model_picker", "keybindings", "theme"],
  "properties": {
    "header": {
      "type": "object",
      "required": ["show", "format"],
      "properties": {
        "show": { "type": "boolean" },
        "format": { "type": "string" },
        "status_indicators": {
          "type": "object",
          "properties": { "idle": { "type": "string" }, "busy": { "type": "string" }, "error": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "chat": {
      "type": "object",
      "required": ["min_height", "max_scroll_back", "show_timestamps", "cancelled_label"],
      "properties": {
        "min_height": { "type": "integer", "minimum": 1 },
        "max_scroll_back": { "type": "integer", "minimum": 10 },
        "show_timestamps": { "type": "boolean" },
        "user_prefix": { "type": "string" },
        "assistant_prefix": { "type": "string" },
        "tool_prefix": { "type": "string" },
        "error_prefix": { "type": "string" },
        "cancelled_label": { "type": "string", "minLength": 1, "description": "Neutral note shown when a running turn is cancelled." }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["history_size", "min_lines", "max_lines"],
      "properties": {
        "history_size": { "type": "integer", "minimum": 1 },
        "min_lines": { "type": "integer", "minimum": 1 },
        "max_lines": { "type": "integer", "minimum": 1 },
        "prompt_symbol": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "description": "Backend session ids per tui session, resumed after a restart.",
      "required": ["dir", "max_age_days", "labels"],
      "properties": {
        "dir": { "type": "string", "minLength": 1, "description": "Directory of <tui session id>.json files; ~/ is the home directory." },
        "max_age_days": { "type": "integer", "minimum": 1, "description": "Store files of other tui sessions unused this long are deleted on tui start." },
        "labels": {
          "type": "object",
          "required": ["resumed", "new"],
          "properties": { "resumed": { "type": "string", "minLength": 1 }, "new": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "required": ["kitty_keyboard"],
      "properties": {
        "kitty_keyboard": { "type": "boolean", "description": "Enable the kitty keyboard protocol (Shift+Enter, Ctrl+J as distinct keys)." }
      },
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "required": ["fallbacks", "temp_pattern"],
      "properties": {
        "fallbacks": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Editors tried on PATH when $VISUAL and $EDITOR are unset." },
        "temp_pattern": { "type": "string", "minLength": 1, "description": "os.CreateTemp pattern for the prompt file." }
      },
      "additionalProperties": false
    },
    "native": {
      "type": "object",
      "description": "open_native key: the provider's own interactive CLI on the active backend session.",
      "required": ["labels"],
      "properties": {
        "labels": {
          "type": "object",
          "description": "Chat notes; placeholder {{ .Provider }}.",
          "required": ["returned", "unsupported", "no_session", "busy", "unavailable", "invalid_session"],
          "properties": { "returned": { "type": "string", "minLength": 1 }, "unsupported": { "type": "string", "minLength": 1 }, "no_session": { "type": "string", "minLength": 1 }, "busy": { "type": "string", "minLength": 1 }, "unavailable": { "type": "string", "minLength": 1 }, "invalid_session": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "required": ["prefix", "shell", "log_buffer_bytes", "cancel_grace_ms", "max_finished", "labels"],
      "properties": {
        "prefix": { "type": "string", "minLength": 1, "description": "Prompt prefix that runs the rest as a background shell job." },
        "shell": { "type": "string", "minLength": 1, "description": "Shell run as <shell> -c <command>." },
        "log_buffer_bytes": { "type": "integer", "minimum": 1, "description": "Ring buffer size of captured output per job." },
        "cancel_grace_ms": { "type": "integer", "minimum": 1, "description": "Delay between SIGTERM and SIGKILL to the job's process group." },
        "max_finished": { "type": "integer", "minimum": 1, "description": "Ended jobs kept in the registry; older ones are pruned." },
        "labels": {
          "type": "object",
          "required": ["started", "done", "usage", "unavailable", "panel_title", "log_title", "panel_empty", "panel_hint", "log_hint", "header_running"],
          "properties": { "started": { "type": "string", "minLength": 1 }, "done": { "type": "string", "minLength": 1 }, "usage": { "type": "string", "minLength": 1 }, "unavailable": { "type": "string", "minLength": 1 }, "panel_title": { "type": "string", "minLength": 1 }, "log_title": { "type": "string", "minLength": 1 }, "panel_empty": { "type": "string", "minLength": 1 }, "panel_hint": { "type": "string", "minLength": 1 }, "log_hint": { "type": "string", "minLength": 1 }, "header_running": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "picker": {
      "type": "object",
      "required": ["file_trigger", "command_trigger", "max_items", "max_width", "max_indexed_files", "skip_dirs", "builtins", "labels"],
      "properties": {
        "file_trigger": { "type": "string", "minLength": 1, "maxLength": 1, "description": "Opens the file picker at the start of a word." },
        "command_trigger": { "type": "string", "minLength": 1, "maxLength": 1, "description": "Opens the command picker at the very start of the prompt." },
        "max_items": { "type": "integer", "minimum": 1, "description": "Rows shown in a picker." },
        "max_width": { "type": "integer", "minimum": 10, "description": "Picker box width cap in display columns." },
        "max_indexed_files": { "type": "integer", "minimum": 1, "description": "File index cap per session." },
        "skip_dirs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Directory names the non-git file walk skips at any depth (heavy trees such as node_modules)." },
        "builtins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "usage"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "usage": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "labels": {
          "type": "object",
          "required": ["files_title", "commands_title", "indexing", "no_matches", "read_error"],
          "properties": { "files_title": { "type": "string", "minLength": 1 }, "commands_title": { "type": "string", "minLength": 1 }, "indexing": { "type": "string", "minLength": 1 }, "no_matches": { "type": "string", "minLength": 1 }, "read_error": { "type": "string", "minLength": 1, "description": "Replaces no_matches when the file walk failed; {{ .Error }} is the error." } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "model_picker": {
      "type": "object",
      "required": ["title", "hint", "active_marker", "session_marker", "max_width", "labels"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1, "description": "Dim last row of the overlay." },
        "active_marker": { "type": "string", "minLength": 1, "description": "Marks the active model's row." },
        "session_marker": { "type": "string", "minLength": 1, "description": "Marks a model with a stored backend session in this tui session." },
        "max_width": { "type": "integer", "minimum": 20, "description": "Overlay width cap in display columns." },
        "labels": {
          "type": "object",
          "required": ["switched", "switched_busy", "no_matches"],
          "properties": { "switched": { "type": "string", "minLength": 1, "description": "Chat note after a switch; {{ .Model }} is the new spec." }, "switched_busy": { "type": "string", "minLength": 1, "description": "Chat note after a switch while a turn runs." }, "no_matches": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "keybindings": {
      "type": "object",
      "required": ["send_prompt", "newline", "quit", "scroll_up", "scroll_down"],
      "properties": {
        "send_prompt": { "type": "array", "items": { "type": "string" } },
        "newline": { "type": "array", "items": { "type": "string" } },
        "quit": { "type": "array", "items": { "type": "string" } },
        "cancel_turn": { "type": "array", "items": { "type": "string" } },
        "scroll_up": { "type": "array", "items": { "type": "string" } },
        "scroll_down": { "type": "array", "items": { "type": "string" } },
        "open_editor": { "type": "array", "items": { "type": "string" } },
        "open_native": { "type": "array", "items": { "type": "string" } },
        "toggle_jobs": { "type": "array", "items": { "type": "string" } },
        "open_models": { "type": "array", "items": { "type": "string" }, "description": "Open the model picker overlay." },
        "job_open": { "type": "array", "items": { "type": "string" } },
        "job_cancel": { "type": "array", "items": { "type": "string" } },
        "job_close": { "type": "array", "items": { "type": "string" } },
        "line_start": { "type": "array", "items": { "type": "string" }, "description": "Cursor to the start of the current prompt line." },
        "line_end": { "type": "array", "items": { "type": "string" }, "description": "Cursor to the end of the current prompt line." },
        "delete_to_start": { "type": "array", "items": { "type": "string" }, "description": "Delete from line start to the cursor." },
        "delete_to_end": { "type": "array", "items": { "type": "string" }, "description": "Delete from the cursor to line end." },
        "delete_word": { "type": "array", "items": { "type": "string" }, "description": "Delete the word before the cursor." },
        "word_left": { "type": "array", "items": { "type": "string" }, "description": "Cursor to the previous word start on the line." },
        "word_right": { "type": "array", "items": { "type": "string" }, "description": "Cursor to the next word end on the line." },
        "picker_select": { "type": "array", "items": { "type": "string" } },
        "picker_close": { "type": "array", "items": { "type": "string" } },
        "picker_up": { "type": "array", "items": { "type": "string" } },
        "picker_down": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["border_style"],
      "properties": {
        "border_style": { "type": "string", "enum": ["sharp", "rounded", "single", "double", "none"] },
        "header_color": { "type": "string" },
        "user_color": { "type": "string" },
        "assistant_color": { "type": "string" },
        "tool_color": { "type": "string" },
        "input_color": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
