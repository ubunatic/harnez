{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reading & Context Discipline spec",
  "type": "object",
  "required": ["max_lines", "deny_message", "repeat_message", "subagent_guidance"],
  "properties": {
    "max_lines": { "type": "integer", "minimum": 1 },
    "deny_message": { "type": "string", "minLength": 1, "pattern": "\\{max_lines\\}" },
    "repeat_message": { "type": "string", "minLength": 1 },
    "subagent_guidance": { "type": "string", "minLength": 1, "pattern": "\\{max_lines\\}" }
  },
  "additionalProperties": false
}
