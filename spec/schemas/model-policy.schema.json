{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.harnez.dev/model-policy.schema.json",
  "type": "object",
  "required": ["version", "default_enabled", "enabled", "models"],
  "properties": {
    "version": { "const": 1 },
    "default_enabled": { "type": "boolean" },
    "enabled": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._/-]*(:(low|med|high))?$" },
      "uniqueItems": true
    },
    "models": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._/-]*(:(low|med|high))?$" },
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["custom", "patch"] },
          "identity": { "$ref": "agent.schema.json#/$defs/modelIdentity" },
          "version_pin": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "fields": {
            "type": "object",
            "properties": {
              "tier": { "type": ["string", "null"], "enum": ["low", "med", "high", null] },
              "aliases": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "capabilities": { "type": ["array", "null"], "items": { "type": "string" } },
              "pitfalls": { "type": ["array", "null"], "items": { "type": "string" } },
              "purpose": { "type": ["string", "null"] },
              "relative_cost": { "type": ["number", "null"], "exclusiveMinimum": 0 },
              "api_cost": { "anyOf": [{ "$ref": "agent.schema.json#/$defs/apiCost" }, { "type": "null" }] },
              "subscription_cost": { "anyOf": [{ "$ref": "agent.schema.json#/$defs/subscriptionCost" }, { "type": "null" }] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "custom" } }, "required": ["kind"] },
            "then": { "required": ["identity"] }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
