{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "provider",
    "platforms",
    "artifacts",
    "probes"
  ],
  "properties": {
    "id": {
      "const": "voice-input"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "version",
        "model",
        "model_size_mib"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_size_mib": {
          "type": "integer"
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "os",
          "arch",
          "distro",
          "version",
          "desktop",
          "session",
          "canary_verified",
          "canary_note"
        ],
        "additionalProperties": false,
        "properties": {
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "distro": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "desktop": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "canary_verified": {
            "type": "boolean"
          },
          "canary_note": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "user",
        "system"
      ],
      "properties": {
        "user": {
          "type": "object",
          "required": [
            "filename",
            "url",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "system": {
          "type": "object",
          "required": [
            "filename",
            "url",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "required": [
        "commands",
        "user_service"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "user_service": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
