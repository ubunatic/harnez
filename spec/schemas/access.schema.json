{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime access manifest",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "root",
          "path",
          "access",
          "purpose"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "root": {
            "enum": [
              "home",
              "repo",
              "tmp",
              "xdg_data_home",
              "xdg_state_home",
              "xdg_cache_home",
              "xdg_runtime_dir"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[^/]"
          },
          "access": {
            "enum": [
              "read",
              "readwrite"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
