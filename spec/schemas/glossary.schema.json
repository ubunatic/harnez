{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez machine-readable glossary",
  "type": "object",
  "required": ["version", "terms"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "include_base": {
      "type": "boolean"
    },
    "default_scope": {
      "$ref": "#/definitions/scope"
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/term"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "scope": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "forbidden_term": {
      "type": "object",
      "required": ["phrase", "replacement"],
      "properties": {
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "case_sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "required": ["term", "definition"],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["preferred", "deprecated"]
        },
        "enabled": {
          "type": "boolean"
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "code_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/forbidden_term"
          }
        },
        "scope": {
          "$ref": "#/definitions/scope"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "see_also": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
