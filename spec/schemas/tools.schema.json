{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tools", "installers", "profiles"],
  "additionalProperties": false,
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "installer", "package", "binary"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "installer": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "package": { "type": "string", "minLength": 1 },
          "binary": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        }
      }
    },
    "installers": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "docs": { "type": "array", "items": { "type": "string" } },
          "tools": { "type": "array", "items": { "type": "string" } },
          "components": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
