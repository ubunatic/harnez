{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Go test runner limits",
  "type": "object",
  "required": ["go_test_parallelism", "go_test_timeout"],
  "properties": {
    "go_test_parallelism": { "type": "integer", "minimum": 1 },
    "go_test_timeout": { "type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$" }
  },
  "additionalProperties": false
}
