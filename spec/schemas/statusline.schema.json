{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez status-line templates",
  "type": "object",
  "required": ["statusline"],
  "properties": {
    "statusline": {
      "type": "object",
      "required": ["claude", "agy", "codex"],
      "properties": {
        "claude": {"type": "string", "minLength": 1},
        "agy": {"type": "string", "minLength": 1},
        "codex": {
          "type": "object",
          "required": ["items", "remove_legacy_items"],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["current-dir", "thread-name", "model", "context-window-size", "context-used"]
              }
            },
            "remove_legacy_items": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["model-context", "model-with-reasoning", "context-remaining", "five-hour-limit", "weekly-limit"]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
