{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.harnez.dev/agent.schema.json",
  "type": "object",
  "$defs": {
    "modelIdentity": {
      "type": "object",
      "required": ["harness", "provider", "model", "version"],
      "properties": {
        "harness": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "enum": ["low", "med", "high"] }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["value", "source", "observed_at", "evidence"],
      "properties": {
        "value": {},
        "source": { "type": "string", "enum": ["spec-default", "web", "discovered", "measured", "user-declared"] },
        "source_url": { "type": "string", "format": "uri" },
        "method": { "type": "string", "minLength": 1 },
        "disputed": { "type": "boolean", "description": "Set by the evidence producer on an individual fact when credible observations conflict; readers retain and surface all facts and do not select one by array order." },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "account": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "properties": { "source": { "const": "web" } }, "required": ["source"] }, "then": { "required": ["source_url"] } },
        { "if": { "properties": { "source": { "const": "discovered" } }, "required": ["source"] }, "then": { "required": ["method", "account"] } }
      ],
      "additionalProperties": false
    },
    "apiCost": {
      "type": "object",
      "required": ["input_per_million", "output_per_million", "cache_per_million", "effective_date"],
      "properties": {
        "input_per_million": { "type": ["number", "null"], "minimum": 0 },
        "output_per_million": { "type": ["number", "null"], "minimum": 0 },
        "cache_per_million": { "type": ["number", "null"], "minimum": 0 },
        "effective_date": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "subscriptionCost": {
      "type": "object",
      "required": ["plan", "currency", "period", "quota"],
      "properties": {
        "plan": { "type": ["string", "null"] },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "period": { "type": ["string", "null"], "enum": ["day", "month", "year", null] },
        "quota": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "required": ["default_model", "role_classify_timeout_ms", "reply_history_limit", "compact_threshold_tokens", "default_role", "models", "roles", "stop", "external_sessions"],
  "properties": {
    "role_classify_timeout_ms": { "type": "integer", "minimum": 1 },
    "reply_history_limit": { "type": "integer", "minimum": 1 },
    "compact_threshold_tokens": { "type": "integer", "minimum": 1, "description": "Default context token threshold for automatic agent compaction." },
    "model_probe_budget": {
      "type": "object",
      "required": ["max_calls_per_update", "max_output_tokens_per_call", "timeout_seconds"],
      "properties": {
        "max_calls_per_update": { "type": "integer", "minimum": 1 },
        "max_output_tokens_per_call": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "stale_session_errors": {
      "type": "object",
      "description": "Per provider: verified CLI stderr line prefixes that mean the resumed session is gone.",
      "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "known_error_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "match_text", "check", "warning"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "match_text": { "type": "string", "minLength": 1 },
          "check": { "type": "string", "enum": ["quota_available"] },
          "warning": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "resume_note": {
      "type": "object",
      "required": ["idle_threshold", "text"],
      "properties": {
        "idle_threshold": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stop": {
      "type": "object",
      "required": ["grace_ms", "kill_wait_ms", "poll_ms"],
      "properties": {
        "grace_ms": { "type": "integer", "minimum": 1 },
        "kill_wait_ms": { "type": "integer", "minimum": 1 },
        "poll_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "selftest": {
      "type": "object",
      "required": ["background_duration_ms"],
      "properties": {
        "background_duration_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "external_sessions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["root", "pattern", "format", "record_type_path", "record_type", "max_record_bytes", "active_match_window_seconds", "name_prefix", "available_status", "fields"],
        "properties": {
          "root": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["jsonl"] },
          "record_type_path": { "type": "string", "minLength": 1 },
          "record_type": { "type": "string", "minLength": 1 },
          "max_record_bytes": { "type": "integer", "minimum": 1 },
          "active_match_window_seconds": { "type": "integer", "minimum": 1 },
          "name_prefix": { "type": "string", "minLength": 1 },
          "available_status": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "object",
            "required": ["id", "working_dir", "model_provider", "source", "created_at"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "provider_session_id": { "type": "string", "minLength": 1 },
              "working_dir": { "type": "string", "minLength": 1 },
              "model_provider": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "created_at": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "default_model": { "type": "string", "minLength": 1 },
    "default_role": { "type": "string", "minLength": 1 },
    "models_legend": { "type": "string" },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["provider", "name", "tier"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "tier": { "type": "string", "enum": ["low", "med", "high"] },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "preferred": { "type": "boolean" },
          "effort": { "type": "boolean" },
          "roles": { "type": "string" },
          "cost": { "type": "integer", "minimum": 1 },
          "cost_by_tier": {
            "type": "object",
            "properties": {
              "low": { "type": "integer", "minimum": 1 },
              "med": { "type": "integer", "minimum": 1 },
              "high": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "eff": { "type": "string", "enum": ["+", "~", "-", "?"] },
          "skills": { "type": "string", "pattern": "^(Go|TUI|SQL)[-+~?]( (Go|TUI|SQL)[-+~?])*$" },
          "use": { "type": "string" },
          "use_med": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "spawns", "rules"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "spawns": { "type": "array", "items": { "type": "string" } },
          "rules": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
