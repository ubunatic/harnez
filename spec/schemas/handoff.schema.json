{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["profiles", "agents"],
  "additionalProperties": false,
  "definitions": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "profile": {
      "type": "object",
      "required": ["description", "rules"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "rules": { "$ref": "#/definitions/lines" }
      }
    }
  },
  "properties": {
    "profiles": {
      "type": "object",
      "required": ["local", "cloud"],
      "additionalProperties": false,
      "properties": {
        "local": { "$ref": "#/definitions/profile" },
        "cloud": { "$ref": "#/definitions/profile" }
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "profile", "aliases", "facts"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "enum": ["local", "cloud"] },
          "aliases": { "$ref": "#/definitions/lines" },
          "hosts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]+$" }
          },
          "facts": { "$ref": "#/definitions/lines" },
          "result": { "type": "string", "minLength": 1 }
        },
        "if": { "properties": { "profile": { "const": "cloud" } } },
        "then": { "required": ["hosts", "result"] },
        "else": { "not": { "anyOf": [{ "required": ["hosts"] }, { "required": ["result"] }] } }
      }
    }
  }
}
