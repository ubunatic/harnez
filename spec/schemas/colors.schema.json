{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubunatic.com/harnez/spec/schemas/colors.schema.json",
  "title": "harnez usage --watch color registry",
  "type": "object",
  "required": ["colors"],
  "properties": {
    "colors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "sgr": {
            "type": "string",
            "pattern": "^[0-9]+(;[0-9]+)*$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
