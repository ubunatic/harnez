{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez issue lifecycle vocabulary",
  "type": "object",
  "required": ["lifecycle", "duplicate_gate", "issue_index"],
  "properties": {
    "lifecycle": {
      "type": "object",
      "required": ["unresolved", "fallback_order", "statuses"],
      "properties": {
        "unresolved": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fallback_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label", "category", "filters", "match_mode", "match_terms"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "enum": ["Open", "Closed", "Draft", "Backlog"] },
              "filters": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "match_mode": {
                "type": "string",
                "enum": ["lead_contains", "lead_exact", "lead_exact_dash", "lead_token"]
              },
              "match_terms": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "fallback_terms": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "duplicate_gate": {
      "type": "object",
      "required": ["threshold", "max_results", "minimum_query_tokens", "minimum_token_length", "title_weight", "body_weight", "stopwords"],
      "properties": {
        "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_results": { "type": "integer", "minimum": 1 },
        "minimum_query_tokens": { "type": "integer", "minimum": 1 },
        "minimum_token_length": { "type": "integer", "minimum": 1 },
        "title_weight": { "type": "integer", "minimum": 1 },
        "body_weight": { "type": "integer", "minimum": 1 },
        "stopwords": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "issue_index": {
      "type": "object",
      "required": ["active_cap"],
      "properties": {
        "active_cap": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
