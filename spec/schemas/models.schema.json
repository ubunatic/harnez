{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.harnez.dev/models.schema.json",
  "type": "object",
  "required": ["version", "models"],
  "properties": {
    "version": { "const": 1 },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identity", "facts"],
        "properties": {
          "identity": { "$ref": "agent.schema.json#/$defs/modelIdentity" },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "facts": {
            "type": "object",
            "properties": {
              "capabilities": { "$ref": "#/$defs/factSet" },
              "pitfalls": { "$ref": "#/$defs/factSet" },
              "purpose": { "$ref": "#/$defs/factSet" },
              "relative_cost": { "$ref": "#/$defs/relativeCostFacts" },
              "api_cost": { "$ref": "#/$defs/apiCostFacts" },
              "subscription_cost": { "$ref": "#/$defs/subscriptionCostFacts" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "factSet": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "agent.schema.json#/$defs/fact" }
    },
    "relativeCostFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "agent.schema.json#/$defs/fact" },
          { "properties": { "value": { "type": ["number", "null"], "exclusiveMinimum": 0 } } }
        ]
      }
    },
    "apiCostFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "agent.schema.json#/$defs/fact" },
          { "properties": { "value": { "$ref": "agent.schema.json#/$defs/apiCost" } } }
        ]
      }
    },
    "subscriptionCostFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "agent.schema.json#/$defs/fact" },
          { "properties": { "value": { "$ref": "agent.schema.json#/$defs/subscriptionCost" } } }
        ]
      }
    }
  }
}
