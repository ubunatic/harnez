{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harnez exec settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["truncate"],
  "properties": {
    "truncate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_output_bytes", "max_output_lines", "spill_dir", "spill_prefix"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_lines": {
          "type": "integer",
          "minimum": 0
        },
        "spill_dir": {
          "type": "string"
        },
        "spill_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]*$"
        }
      }
    }
  }
}
