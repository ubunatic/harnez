{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubunatic.com/harnez/spec/schemas/actions.schema.json",
  "title": "harnez usage --watch hotkey registry",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["title", "keys", "symbol", "category"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(<c-c>|<esc>|.)$"
            }
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": ["box", "data", "mode", "session"]
          },
          "box": {
            "type": "string",
            "enum": [
              "all_usage",
              "claude",
              "agy",
              "codex",
              "history",
              "processes",
              "load"
            ]
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": { "category": { "const": "box" } }
        },
        "then": {
          "required": ["box"]
        }
      }
    }
  },
  "additionalProperties": false
}
