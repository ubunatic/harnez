{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema",
    "statements",
    "predicates",
    "group_columns",
    "quality_checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "statements": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "predicates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "sql"
        ],
        "additionalProperties": false,
        "properties": {
          "sql": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "group_columns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tool_name",
          "agent_id",
          "project_name"
        ]
      },
      "minItems": 1
    },
    "quality_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sql", "description", "warn_above_percent", "result"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sql": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "warn_above_percent": {"type": "number", "minimum": 0},
          "result": {
            "type": "object",
            "required": ["checked", "offending", "percentage"],
            "additionalProperties": false,
            "properties": {
              "checked": {"type": "string", "const": "checked"},
              "offending": {"type": "string", "const": "offending"},
              "percentage": {"type": "string", "const": "percentage"}
            }
          }
        }
      }
    }
  }
}
