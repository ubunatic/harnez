{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["state_dir", "session_env", "items", "never"],
  "properties": {
    "state_dir": { "type": "string", "minLength": 1 },
    "session_env": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class", "item", "description"],
        "properties": {
          "class": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "item": { "type": "string", "pattern": "^(\\*|[a-z0-9][a-z0-9-]*)$" },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "never": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
