{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.harnez.dev/model-snapshot.schema.json",
  "type": "object",
  "required": ["version", "id", "created_at", "previous", "effective_catalog", "access", "policy", "applied"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "previous": { "type": ["string", "null"] },
    "effective_catalog": { "$ref": "models.schema.json" },
    "access": { "$ref": "model-access.schema.json" },
    "policy": { "anyOf": [{ "$ref": "model-policy.schema.json" }, { "type": "null" }] },
    "applied": { "type": "boolean" }
  },
  "additionalProperties": false
}
