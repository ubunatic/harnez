{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubunatic.com/harnez/spec/schemas/indicators.schema.json",
  "title": "harnez usage --watch indicators",
  "type": "object",
  "required": ["timeout-snake", "usage-bar", "load-sparkline"],
  "properties": {
    "timeout-snake": {
      "type": "object",
      "required": ["title", "frames"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "frames": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "pattern": "^[\\u2800-\\u28FF]$"}
        }
      },
      "additionalProperties": false
    },
    "usage-bar": {
      "type": "object",
      "required": ["filled", "empty", "sub-character"],
      "properties": {
        "filled": {"type": "string", "pattern": "^.{1}$"},
        "empty": {"type": "string", "pattern": "^.{1}$"},
        "sub-character": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^.{1}$"}
        }
      },
      "additionalProperties": false
    },
    "load-sparkline": {
      "type": "object",
      "required": ["frames"],
      "properties": {
        "frames": {
          "type": "array", "minItems": 2,
          "items": {"type": "string", "pattern": "^.{1}$"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
