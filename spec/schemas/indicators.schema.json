{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubunatic.com/harnez/spec/schemas/indicators.schema.json",
  "title": "harnez usage --watch indicators",
  "type": "object",
  "required": ["sequences", "timeout-snake", "usage-bar", "load-sparkline", "chart-background", "load-chart-presentation", "usage-bar-presentation", "load-charts"],
  "properties": {
    "sequences": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/definitions/named-sequence"}
    },
    "timeout-snake": {
      "type": "object",
      "required": ["title", "sequence"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "sequence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "usage-bar": {
      "type": "object",
      "required": ["filled", "empty", "sub-character-sequence"],
      "properties": {
        "filled": {"type": "string", "pattern": "^.{1}$"},
        "empty": {"type": "string", "pattern": "^.{1}$"},
        "sub-character-sequence": {"type": "string", "minLength": 1},
        "style": {"type": "string", "enum": ["block", "braille"]},
        "braille": {
          "type": "object",
          "properties": {
            "full": {"type": "string", "pattern": "^.{1}$"},
            "half": {"type": "string", "pattern": "^.{1}$"},
            "empty": {"type": "string", "pattern": "^.{1}$"}
          },
          "additionalProperties": false
        },
        "wrapper": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "left": {"type": "string"},
            "right": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "load-sparkline": {
      "type": "object",
      "required": ["sequence"],
      "properties": {
        "sequence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "chart-background": {
      "type": "string",
      "enum": ["panel-bg"]
    },
    "load-chart-presentation": {
      "type": "string",
      "enum": ["monochrome", "heat"]
    },
    "usage-bar-presentation": {
      "type": "string",
      "enum": ["monochrome", "heat"]
    },
    "load-charts": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "enum": ["sparkline", "timeseries", "braille", "btop", "bar", "gauge"]
        },
        "gpu": {
          "type": "string",
          "enum": ["sparkline", "timeseries", "braille", "btop", "bar", "gauge"]
        },
        "ram": {
          "type": "string",
          "enum": ["sparkline", "timeseries", "braille", "btop", "bar", "gauge"]
        },
        "vram": {
          "type": "string",
          "enum": ["sparkline", "timeseries", "braille", "btop", "bar", "gauge"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "named-sequence": {
      "type": "object",
      "required": ["title", "kind", "frames"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["countdown", "spinner", "bar-partial", "sparkline"]
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^.{1}$"}
        }
      },
      "additionalProperties": false
    }
  }
}
