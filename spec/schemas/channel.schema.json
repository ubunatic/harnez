{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez local channel canary",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_dir", "listen_address", "server_name", "server_version", "protocol_version", "io_timeout_ms", "max_message_bytes", "max_rpc_bytes", "canary_model", "canary_message", "instructions"],
  "properties": {
    "registry_dir": {"type": "string", "minLength": 1},
    "listen_address": {"type": "string", "minLength": 1},
    "server_name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "server_version": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "io_timeout_ms": {"type": "integer", "minimum": 1},
    "max_message_bytes": {"type": "integer", "minimum": 1},
    "max_rpc_bytes": {"type": "integer", "minimum": 1},
    "canary_model": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "canary_message": {"type": "string", "minLength": 1},
    "instructions": {"type": "string", "minLength": 1}
  }
}
