{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Release publishing settings",
  "type": "object",
  "required": ["upload_retry_attempts", "upload_retry_delay", "release_not_found_pattern"],
  "properties": {
    "upload_retry_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "upload_retry_delay": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$" },
    "release_not_found_pattern": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
