{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez per-repository config",
  "type": "object",
  "required": ["version", "issues", "docs", "rules", "make"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "issues": {
      "type": "object",
      "required": ["tracker", "merge_driver"],
      "properties": {
        "tracker": {"type": "string", "enum": ["harnez", "none"]},
        "merge_driver": {"type": "boolean"},
        "active_cap": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "docs": {
      "type": "object",
      "required": ["studies", "copies"],
      "properties": {
        "studies": {"type": "boolean"},
        "copies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": ["quota"],
      "properties": {"quota": {"type": "boolean"}},
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["solo", "fork", "team"]},
        "protected_main": {"type": "boolean"},
        "default_branch": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"mode": {"const": "solo"}}, "required": ["mode"]},
      "then": {"properties": {"protected_main": {"const": false}}},
      "additionalProperties": false
    },
    "make": {
      "type": "object",
      "required": ["container_test"],
      "properties": {
        "scaffold": {"type": "boolean"},
        "container_test": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
