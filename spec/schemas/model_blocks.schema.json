{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["default_duration", "patterns"],
  "additionalProperties": false,
  "properties": {
    "default_duration": { "type": "string", "pattern": "^[0-9]+(s|m|h)$" },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider", "contains"],
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "reset_in_regex": { "type": "string" },
          "reset_at_regex": { "type": "string" }
        }
      }
    }
  }
}
