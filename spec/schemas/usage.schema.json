{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez usage settings and view modes",
  "type": "object",
  "required": ["agy_quota", "agy_meter_max_age", "collector_cadence", "cache_staleness_multiplier", "display_staleness", "collector_timeout", "passive_dedupe_interval", "history_snapshot_interval", "statusline_busy_timeout", "statusline_write_timeout", "watch_loading_label", "view_modes", "export_host_key", "nvidia_smi_timeout", "nvidia_smi_cache_ttl", "agent_quota_warn_percent", "agent_quota_max_reading_age"],
  "properties": {
    "agent_quota_warn_percent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "agent_quota_max_reading_age": { "type": "string", "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$" },
    "agy_quota": {
      "type": "object",
      "required": ["default_pool", "model_pools", "meter_buckets"],
      "additionalProperties": false,
      "properties": {
        "default_pool": { "type": "string", "minLength": 1 },
        "model_pools": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["contains", "pool"], "additionalProperties": false,
            "properties": {
              "contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "pool": { "type": "string", "minLength": 1 }
            }
          }
        },
        "meter_buckets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["bucket", "group", "window"], "additionalProperties": false,
            "properties": {
              "bucket": { "type": "string", "minLength": 1 },
              "group": { "type": "string", "minLength": 1 },
              "window": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "export_host_key": {
      "type": "string",
      "minLength": 1
    },
    "watch_loading_label": {

      "type": "string",
      "minLength": 1
    },
    "view_modes": {
      "type": "object",
      "required": ["default", "modes"],
      "properties": {
        "default": { "type": "string", "enum": ["normal", "compact", "minimal"], "default": "normal" },
        "modes": {
          "type": "object",
          "required": ["normal", "compact", "minimal"],
          "properties": {
            "normal": { "$ref": "#/definitions/viewMode" },
            "compact": { "$ref": "#/definitions/viewMode" },
            "minimal": { "$ref": "#/definitions/viewMode" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agy_meter_max_age": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "collector_cadence": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "cache_staleness_multiplier": {
      "type": "integer",
      "minimum": 1
    },
    "display_staleness": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "collector_timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "passive_dedupe_interval": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "history_snapshot_interval": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "statusline_busy_timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "statusline_write_timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "nvidia_smi_timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "nvidia_smi_cache_ttl": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    }
  },
  "definitions": {
    "viewMode": {
      "type": "object",
      "required": ["panels", "token_details", "title_bar", "status_bar", "hidden_list", "overflow_hint"],
      "properties": {
        "panels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["table", "all_usage", "processes", "load", "mic", "remote_load"] }
        },
        "token_details": { "type": "boolean" },
        "title_bar": { "type": "boolean" },
        "status_bar": { "type": "boolean" },
        "hidden_list": { "type": "boolean" },
        "overflow_hint": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
