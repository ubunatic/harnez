{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez usage collection settings",
  "type": "object",
  "required": ["agy_meter_max_age", "collector_cadence", "collector_timeout"],
  "properties": {
    "agy_meter_max_age": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "collector_cadence": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    },
    "collector_timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$"
    }
  },
  "additionalProperties": false
}
