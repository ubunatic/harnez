{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Session ownership and trusted promotion contract",
  "type": "object",
  "required": [
    "version",
    "session_dir_env",
    "ownership",
    "runner_operations",
    "host_only_operations",
    "promoter",
    "runner_paths",
    "bwrap"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "session_dir_env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "resource",
          "class"
        ],
        "additionalProperties": false,
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "runner",
              "broker",
              "shared"
            ]
          }
        }
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "session_locks_history"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "exec_process_records"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "local_usage_caches_durations_killlog_passive_debug"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "livefetchcache"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "agy_ca_key_bundle_usage_backoff"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "policy_overlays"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "telemetry_spool"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "debug_feedback_bench_legacyarchive_writes"
              },
              "class": {
                "const": "runner"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "telemetry_ingestion_bounded_replay"
              },
              "class": {
                "const": "broker"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "canonical_usage_snapshots_history"
              },
              "class": {
                "const": "broker"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "own_session_registry"
              },
              "class": {
                "const": "broker"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "host_agent_discovery_resume"
              },
              "class": {
                "const": "shared"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "global_policy_read_only_to_runner"
              },
              "class": {
                "const": "shared"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "host_provisioned_runtime_shims"
              },
              "class": {
                "const": "shared"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "resource",
              "class"
            ],
            "properties": {
              "resource": {
                "const": "repo_quota_checkout_coordination"
              },
              "class": {
                "const": "shared"
              }
            }
          }
        }
      ]
    },
    "runner_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "telemetry_ingest",
          "telemetry_replay",
          "usage_read",
          "own_register",
          "own_update",
          "own_query"
        ]
      },
      "minItems": 1
    },
    "host_only_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "allOf": [
        {
          "contains": {
            "const": "/shutdown"
          }
        },
        {
          "contains": {
            "const": "merge_legacy"
          }
        },
        {
          "contains": {
            "const": "arbitrary_paths"
          }
        },
        {
          "contains": {
            "const": "arbitrary_pids"
          }
        },
        {
          "contains": {
            "const": "cross_session_stop"
          }
        },
        {
          "contains": {
            "const": "cross_session_resume"
          }
        },
        {
          "contains": {
            "const": "global_policy_write"
          }
        }
      ]
    },
    "promoter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_roots",
        "man_roots",
        "binary",
        "alias",
        "alias_target",
        "man_manifest",
        "promotion"
      ],
      "properties": {
        "binary_roots": {
          "const": [
            "GOBIN",
            "GOPATH_bin",
            "HOME_go_bin"
          ],
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "man_roots": {
          "const": [
            "XDG_DATA_HOME_man_man1",
            "HOME_local_share_man_man1"
          ],
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "binary": {
          "const": "harnez"
        },
        "alias": {
          "const": "⚙"
        },
        "alias_target": {
          "const": "harnez"
        },
        "man_manifest": {
          "const": "exact_generated_manifest"
        },
        "promotion": {
          "const": "pinned_nofollow_atomic_per_file"
        }
      }
    },
    "runner_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_state",
        "process_records",
        "usage_state",
        "telemetry_spool",
        "agymeter",
        "logs",
        "feedback",
        "bench",
        "policy"
      ],
      "properties": {
        "session_state": { "$ref": "#/definitions/pathSegments" },
        "process_records": { "$ref": "#/definitions/pathSegments" },
        "usage_state": { "$ref": "#/definitions/pathSegments" },
        "telemetry_spool": { "$ref": "#/definitions/pathSegments" },
        "agymeter": { "$ref": "#/definitions/pathSegments" },
        "logs": { "$ref": "#/definitions/pathSegments" },
        "feedback": { "$ref": "#/definitions/pathSegments" },
        "bench": { "$ref": "#/definitions/pathSegments" },
        "policy": { "$ref": "#/definitions/pathSegments" }
      }
    },
    "bwrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confined_failure_prefix",
        "confined_failure_guidance",
        "host_failure_prefix",
        "host_failure_guidance",
        "missing_confined_error",
        "missing_host_error"
      ],
      "properties": {
        "confined_failure_prefix": { "type": "string", "minLength": 1 },
        "confined_failure_guidance": { "type": "string", "minLength": 1 },
        "host_failure_prefix": { "type": "string", "minLength": 1 },
        "host_failure_guidance": { "type": "string", "minLength": 1 },
        "missing_confined_error": { "type": "string", "minLength": 1 },
        "missing_host_error": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "pathSegments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    }
  }
}
