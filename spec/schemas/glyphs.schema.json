{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["charset", "glyphs"],
  "properties": {
    "charset": { "type": "string", "minLength": 1 },
    "glyphs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "enum": ["3x5", "5x8", "6x12", "7x13", "8x16"] },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
