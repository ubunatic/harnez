{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["charset", "glyphs"],
  "properties": {
    "charset": { "type": "string", "minLength": 1 },
    "glyphs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
