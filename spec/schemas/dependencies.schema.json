{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optional dependency packages",
  "type": "object",
  "required": ["packages"],
  "additionalProperties": false,
  "properties": {
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["module", "bootstrap"],
        "additionalProperties": false,
        "properties": {
          "module": {"type": "string", "minLength": 1},
          "bootstrap": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
