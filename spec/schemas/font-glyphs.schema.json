{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["fonts"],
  "properties": {
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["cell", "glyphs"],
        "properties": {
          "cell": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "glyphs": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
