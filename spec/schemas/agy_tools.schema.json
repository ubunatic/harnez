{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ubunatic.com/harnez/spec/schemas/agy_tools.schema.json",
  "title": "harnez AGY tool policy and rejection specification",
  "type": "object",
  "required": ["disallowed_tools"],
  "additionalProperties": false,
  "properties": {
    "disallowed_tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["reason"],
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
