{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harnez apply config (managed global sections)",
  "type": "object",
  "properties": {
    "debloat": {
      "type": "object",
      "properties": {
        "preset_disable_bundled_skills": {"type": "boolean"},
        "preset_disable_claude_ai_connectors": {"type": "boolean"},
        "preset_denied_mcp_servers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "preset_skill_overrides": {
          "type": "object",
          "additionalProperties": {"enum": ["on", "name-only", "user-invocable-only", "off"]}
        },
        "aggressive_skill_overrides": {
          "type": "object",
          "additionalProperties": {"enum": ["on", "name-only", "user-invocable-only", "off"]}
        }
      },
      "additionalProperties": true
    },
    "global_section_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "global_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "content"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "pattern": "^[^<>\\r\\n]+$"},
          "content": {"type": "string"},
          "rate_feedback": {"type": "boolean"},
          "existing_only": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
    "retired_global_sections": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^[^<>\\r\\n]+$"}
    },
  "additionalProperties": true
}
