{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "invalid",
    "prompts"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "invalid": {
      "type": "string",
      "minLength": 1
    },
    "prompts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "explanation"
        ],
        "properties": {
          "key": {
            "enum": [
              "tracker",
              "studies",
              "merge_driver",
              "copies",
              "scaffold",
              "quota"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
