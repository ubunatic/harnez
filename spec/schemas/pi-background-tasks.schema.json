{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ubunatic.com/harnez/spec/schemas/pi-background-tasks.schema.json",
  "title": "Pi background task bounds",
  "description": "Bounds for the project-local Pi background-task extension: captured output, finished-task retention and termination timing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_limit_chars",
    "finished_retention_limit",
    "stop",
    "capture",
    "delivery",
    "status"
  ],
  "properties": {
    "output_limit_chars": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum characters of combined stdout/stderr kept per task (newest kept).",
      "maximum": 9007199254740991
    },
    "finished_retention_limit": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum finished (completed, failed or cancelled) tasks kept; running tasks are never evicted.",
      "maximum": 9007199254740991
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grace_ms",
        "kill_wait_ms",
        "poll_ms"
      ],
      "properties": {
        "grace_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Wait after SIGTERM to the process group before escalating to SIGKILL.",
          "maximum": 9007199254740991
        },
        "kill_wait_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum wait after SIGKILL (and after output-stream drain) before reporting termination as not confirmed.",
          "maximum": 9007199254740991
        },
        "poll_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Interval for re-checking process-group liveness while waiting for termination.",
          "maximum": 9007199254740991
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_warn_ms",
        "flush_poll_ms",
        "batch_window_ms",
        "batch_max_tasks",
        "batch_max_chars",
        "entry_max_chars"
      ],
      "properties": {
        "hold_warn_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Wait before warning that completion notifications are still held for manual compaction, and between checks that the compaction end was not missed.",
          "maximum": 9007199254740991
        },
        "flush_poll_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Interval between batches and checks for a cleared compaction guard.",
          "maximum": 9007199254740991
        },
        "batch_window_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Fixed window from the first queued completion; later arrivals do not reset it."
        },
        "batch_max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "batch_max_chars": {
          "type": "integer",
          "minimum": 512,
          "maximum": 9007199254740991,
          "description": "Maximum completion message characters, including guidance. Loader also requires room for entry_max_chars plus the envelope."
        },
        "entry_max_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 9007199254740991,
          "description": "Maximum characters per entry including task identity; at least 256 for useful status and retrieval context."
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cells",
        "reserved_cells",
        "label_max_cells",
        "fallback_label",
        "manual_emoji",
        "default_emoji",
        "label_emoji"
      ],
      "properties": {
        "max_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reserved_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "label_max_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fallback_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{M}\\p{N}_-]*$"
        },
        "manual_emoji": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\p{C}]+$"
        },
        "default_emoji": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\p{C}]+$"
        },
        "label_emoji": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\p{C}]+$"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled_by_default",
        "low_watermark_bytes",
        "high_watermark_bytes",
        "hard_watermark_bytes",
        "stall_ms",
        "finalize_ms",
        "cleanup_ms",
        "io_concurrency"
      ],
      "properties": {
        "enabled_by_default": {
          "type": "boolean"
        },
        "low_watermark_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "high_watermark_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hard_watermark_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "finalize_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cleanup_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "io_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
