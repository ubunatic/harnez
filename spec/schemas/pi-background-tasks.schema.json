{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ubunatic.com/harnez/spec/schemas/pi-background-tasks.schema.json",
  "title": "Pi background task bounds",
  "description": "Bounds for the project-local Pi background-task extension: captured output, finished-task retention and termination timing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_limit_chars",
    "finished_retention_limit",
    "stop",
    "status"
  ],
  "properties": {
    "output_limit_chars": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum characters of combined stdout/stderr kept per task (newest kept).",
      "maximum": 9007199254740991
    },
    "finished_retention_limit": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum finished (completed, failed or cancelled) tasks kept; running tasks are never evicted.",
      "maximum": 9007199254740991
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grace_ms",
        "kill_wait_ms",
        "poll_ms"
      ],
      "properties": {
        "grace_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Wait after SIGTERM to the process group before escalating to SIGKILL.",
          "maximum": 9007199254740991
        },
        "kill_wait_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum wait after SIGKILL (and after output-stream drain) before reporting termination as not confirmed.",
          "maximum": 9007199254740991
        },
        "poll_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "Interval for re-checking process-group liveness while waiting for termination.",
          "maximum": 9007199254740991
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cells",
        "reserved_cells",
        "label_max_cells",
        "fallback_label",
        "manual_emoji",
        "default_emoji",
        "label_emoji"
      ],
      "properties": {
        "max_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reserved_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "label_max_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fallback_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{M}\\p{N}_-]*$"
        },
        "manual_emoji": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\p{C}]+$"
        },
        "default_emoji": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\p{C}]+$"
        },
        "label_emoji": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\p{C}]+$"
          }
        }
      }
    }
  }
}
