{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harnez forge token settings",
  "type": "object",
  "required": ["scopes", "name_prefix", "keyring_service", "token_dir"],
  "properties": {
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^read:[a-z]+$" }
    },
    "name_prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "keyring_service": { "type": "string", "minLength": 1 },
    "token_dir": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  },
  "additionalProperties": false
}
